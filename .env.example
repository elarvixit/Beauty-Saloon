# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Supabase → Project Settings → API (Data API) gives both values.

SUPABASE_URL=https://your-project-ref.supabase.co
# Secret server-side key. Never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sign-in for the /admin bookings page. Use a long, unique password.
ADMIN_USERNAME=choose-a-user-id
ADMIN_PASSWORD=choose-a-strong-password
